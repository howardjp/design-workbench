---
import fixture from '../../../page-archetypes/content/dashboards.json';
import {dashboardPayload,serializeForScript} from './fixture.mjs';
import Button from '@nightjar/button';
import DashboardNav from './DashboardNav.astro';
import {peerDashboardURL} from './peer.mjs';
const family=process.env.NIGHTJAR_FAMILY;
const {base,page} = Astro.props;
const href=url=>url.startsWith('/')&&!url.startsWith('//')?`${base.replace(/\/$/,'')}${url}`:url;
const peer=peerDashboardURL(process.env.NIGHTJAR_PEER_URL,'analytics');
const peerFamily=family==='martlet'?'Krigsvold':'Martlet';
const variables = Object.entries({ 'a-text':'text','a-muted':'muted','a-bg':'bg','a-panel':'panel','a-line':'line','a-accent':'accent','a-on':'on-accent','a-focus':'focus','a-disabled-bg':'disabled-bg','a-disabled-text':'disabled-text','dash-chart-primary':'chart-1','dash-chart-secondary':'chart-2','dash-warning':'warning','dash-ui-font':'font-sans','ex-muted':'muted' }).map(([name,token])=>`--${name}:var(--${family}-${token})`).join(';');
const initial=fixture.analytics.filter(row=>row.date >= '2026-10-22');
const json=serializeForScript(dashboardPayload('analytics',fixture));
const charts=[{id:'sessions',title:'Session trend',description:'Daily sessions across the selected categories.'},{id:'downloads',title:'Download trend',description:'Daily downloads in the selected period.'},{id:'categories',title:'Category comparison',description:'Current sessions versus the preceding period of equal length, when available.'}];
const metrics=[['sessions','Sessions'],['downloads','Downloads'],['conversion','Completion rate'],['mean_duration','Mean session duration']];
---
<div class="analytics-app" data-analytics-dashboard data-family={family === "martlet" ? "m" : "k"} style={variables}>
  <DashboardNav href={href} current="analytics" />
  <div class="analytics-main">
    <header class="dashboard-heading"><p class="eyebrow">{page.category}</p><h1>{page.title}</h1><p>{page.summary}</p></header>
    <p>Snapshot: <time datetime={fixture.as_of}>28 Oct 2026, 20:00 UTC</time> {peer && <a data-analytics-compare href={peer}>Compare in {peerFamily}</a>}</p>
    <p class="analytics-notice">Synthetic demonstration data. Changes remain in this page’s memory and reset on reload. No live people, systems, or services are connected.</p>
    {fixture.analytics.length === 0 ? <p role="status" data-analytics-empty>No analytics data is available in this snapshot.</p> : <>
    <form id="analytics-filters" novalidate><fieldset disabled data-analytics-controls><legend>Analytics filters</legend><div class="analytics-controls">
      <div><label for="analytics-range">Date range</label><select id="analytics-range" name="range"><option value="7">Last 7 days</option><option value="14">Last 14 days</option><option value="28">Last 28 days</option><option value="custom">Custom range</option></select></div>
      <div><label for="analytics-start">Start date</label><input id="analytics-start" name="start" type="date" min="2026-09-03" max="2026-10-28" value="2026-10-22" required /></div>
      <div><label for="analytics-end">End date</label><input id="analytics-end" name="end" type="date" min="2026-09-03" max="2026-10-28" value="2026-10-28" required /></div>
      <div><label for="analytics-category">Category</label><select id="analytics-category" name="category"><option>All</option>{fixture.categories.map(category=><option>{category}</option>)}</select></div>
    </div><Button type="submit">Apply filters</Button><Button type="button" data-export-analytics>Download filtered CSV</Button></fieldset><p id="analytics-error" role="alert" hidden></p></form>
    <p role="status" data-analytics-status>Published source data is shown below.</p>
    <dl class="analytics-metrics" aria-label="Analytics summary">{metrics.map(([id,label])=><div><dt>{label}</dt><dd><output data-metric={id}>—</output><p data-comparison={id}>Calculated from the table below.</p></dd></div>)}</dl>
    <div class="analytics-charts">{charts.map(chart=><figure class:list={['analytics-chart',`analytics-chart--${chart.id}`]} aria-labelledby={`${chart.id}-title`}><header><h2 id={`${chart.id}-title`}>{chart.title}</h2><p>{chart.description}</p></header><div class="dash-chart__plot" data-chart={chart.id}></div><figcaption data-chart-summary={chart.id}>The data table provides an alternative to the chart.</figcaption><details><summary>View {chart.title.toLowerCase()} data</summary><div class="analytics-table" role="region" aria-label={`${chart.title} data`} tabindex="0"><table data-chart-table={chart.id}><caption>{chart.title} — synthetic data</caption><thead><tr><th scope="col">Label</th><th scope="col">Value</th></tr></thead><tbody><tr><td colspan="2">Chart values appear here when JavaScript is enabled. Published source data follows below.</td></tr></tbody></table></div></details></figure>)}</div>
    <section aria-labelledby="analytics-source-title"><h2 id="analytics-source-title">Analytics source records</h2><p>Counts are synthetic. Completion rate = completed tasks ÷ sessions; mean duration is weighted by session count.</p><div class="analytics-table" role="region" aria-label="Analytics source records" tabindex="0"><table id="analytics-source"><caption>Selected source records — dates and categories</caption><thead><tr><th scope="col">Date</th><th scope="col">Category</th><th scope="col">Sessions</th><th scope="col">Downloads</th><th scope="col">Completed tasks</th></tr></thead><tbody>{initial.map(row=><tr><th scope="row">{row.date}</th><td>{row.category}</td><td>{row.sessions}</td><td>{row.downloads}</td><td>{row.completions}</td></tr>)}</tbody></table></div></section>
    <noscript><p>Interactive filtering and charts require JavaScript. The published data table remains available; controls are disabled.</p></noscript>
    </>}
  </div>
</div>
<script type="application/json" id="analytics-data" is:inline set:html={json}></script>
<script>
const fixture=JSON.parse(document.getElementById('analytics-data').textContent);
import {analyticsView, dayMillis, comparisonSearch} from '../../../page-archetypes/jekyll/assets/js/dashboard-model.mjs';
import {chart, metric, tableRows, downloadCSV} from '../../../page-archetypes/jekyll/assets/js/dashboard-ui.mjs';
const root=document.querySelector('[data-analytics-dashboard]');
const toggle=root.querySelector('.dash-nav-toggle');const navigation=root.querySelector('#dashboard-nav');toggle.hidden=false;root.dataset.ready='true';
toggle.addEventListener('click',()=>toggle.setAttribute('aria-expanded',String(toggle.getAttribute('aria-expanded')!=='true')));navigation.parentElement.addEventListener('keydown',event=>{if(event.key==='Escape'){toggle.setAttribute('aria-expanded','false');toggle.focus();}});
if(fixture.analytics.length){
const form=root.querySelector('#analytics-filters');
const start=form.elements.start,end=form.elements.end,category=form.elements.category,range=form.elements.range;
const params=new URL(location.href).searchParams;
start.value=params.get('start')||start.value;end.value=params.get('end')||end.value;if(fixture.categories.includes(params.get('category')))category.value=params.get('category');if(params.has('start')||params.has('end'))range.value='custom';
form.querySelector('[data-analytics-controls]').disabled=false;
const status=root.querySelector('[data-analytics-status]');let view;
const number=value=>new Intl.NumberFormat('en-US').format(value);
range.addEventListener('change',()=>{if(range.value!=='custom'){end.value='2026-10-28';start.value=new Date(Date.parse(end.value)-(Number(range.value)-1)*dayMillis).toISOString().slice(0,10);}});
[start,end].forEach(input=>input.addEventListener('input',()=>{range.value='custom';}));
function render(){
  const candidate=analyticsView(fixture,{start:start.value,end:end.value,category:category.value});const error=root.querySelector('#analytics-error');
  error.hidden=!candidate.error;error.textContent=candidate.error;start.setAttribute('aria-invalid',String(!!candidate.error));end.setAttribute('aria-invalid',String(!!candidate.error));root.querySelector('[data-export-analytics]').disabled=!!candidate.error;
  if(candidate.error){status.textContent='Invalid filters. The previous valid results remain visible.';error.tabIndex=-1;error.focus();return;}
  view=candidate;const url=new URL(location.href);for(const [key,value] of Object.entries({start:start.value,end:end.value,category:category.value}))url.searchParams.set(key,value);history.replaceState(null,'',url);const compare=root.querySelector('[data-analytics-compare]');if(compare){const peer=new URL(compare.href);peer.search=comparisonSearch('analytics',url.search);compare.href=peer.href;}
  const comparisons=id=>view.previous&&view.previous[id]?`${((view.totals[id]/view.previous[id]-1)*100).toFixed(1)}% versus preceding period.`:'No complete preceding period available.';
  metric(root,'sessions',number(view.totals.sessions),comparisons('sessions'));metric(root,'downloads',number(view.totals.downloads),comparisons('downloads'));metric(root,'conversion',view.totals.conversion.toFixed(1)+'%','Completed tasks ÷ sessions.');metric(root,'mean_duration',Math.round(view.totals.mean_duration)+' s','Weighted by session count.');
  chart(root,'sessions',view.days.map(day=>({label:day.date,value:day.sessions})),{label:'Sessions'});chart(root,'downloads',view.days.map(day=>({label:day.date,value:day.downloads})),{label:'Downloads'});
  const count=Math.round((Date.parse(end.value)-Date.parse(start.value))/dayMillis)+1;const priorEnd=new Date(Date.parse(start.value)-dayMillis).toISOString().slice(0,10),priorStart=new Date(Date.parse(start.value)-count*dayMillis).toISOString().slice(0,10);const prior=view.previous?analyticsView(fixture,{start:priorStart,end:priorEnd,category:category.value}):null;
  chart(root,'categories',view.categories.map(row=>({label:row.name,value:row.sessions,previous:prior?.categories.find(item=>item.name===row.name).sessions??null})),{label:'Sessions by category',bars:true,previous:true});
  tableRows(root.querySelector('#analytics-source'),view.rows.map(row=>[row.date,row.category,row.sessions,row.downloads,row.completions]),['Date','Category','Sessions','Downloads','Completed tasks']);status.textContent=`${view.days.length} days · category: ${category.value} · ${view.rows.length} source records · ${start.value} to ${end.value}.`;
}
form.addEventListener('submit',event=>{event.preventDefault();render();});root.querySelector('[data-export-analytics]').addEventListener('click',()=>{if(view)downloadCSV('northlight-analytics.csv',[['Date','Category','Sessions','Downloads','Completed tasks'],...view.rows.map(row=>[row.date,row.category,row.sessions,row.downloads,row.completions])]);});render();
}
</script>
