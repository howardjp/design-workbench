---
const {page, href} = Astro.props;
---
<div class="recipe" data-example={page.id} data-semantic-class={page.semantic_class}>
  {page.sections.map(section => <section aria-labelledby={section.id}>
    <h2 id={section.id}>{section.title}</h2>
    {section.body && <p>{section.body}</p>}
    {section.kind === 'cards' && <ul class="recipe-list">{section.items.map(item => <li><h3><a href={href(item.url)}>{item.title}</a></h3><p>{item.summary}</p></li>)}</ul>}
    {section.actions && <ul class="recipe-actions">{section.actions.map(action => <li><a href={href(action.url)}>{action.label}</a></li>)}</ul>}
  </section>)}
</div>
<style>
.recipe { max-width: 72rem; margin-inline: auto; padding: 0 1.5rem 3rem; }
.recipe section { margin-block: 2.5rem; }
.recipe-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1.5rem; }
.recipe-list h3 { margin-bottom: .4rem; }
.recipe-actions { list-style: none; padding: 0; display: flex; gap: 1rem; flex-wrap: wrap; }
</style>
