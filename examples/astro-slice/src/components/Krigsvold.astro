---
import { Layout, Button } from '@krigsvold/astro';
import '@krigsvold/theme/source-profile.css';
import './source-shell.css';
import './krigsvold-shell.css';
import SourceHeader from './SourceHeader.astro';
import SourceFooter from './SourceFooter.astro';
import SourceMasthead from './SourceMasthead.astro';
import Content from './Content.astro';
const {page, href, base} = Astro.props;
const name = 'Northlight Field Institute';
const links = [{href:href('/examples/home/'),label:'Home',current:page.id==='home'},{href:href('/examples/about/'),label:'About',current:page.id==='about'}];
---
<Layout title={page.title} description={page.summary} bodyClass="krigsvold-source-profile">
  <script is:inline slot="head" define:vars={{family: 'krigsvold'}}>try { const mode=localStorage.getItem('nightjar-appearance')==='dark'?'dark':'light'; document.documentElement.dataset.appearance=mode;document.documentElement.setAttribute(`data-${family}`,mode); } catch {}</script>
  <SourceHeader slot="header" name={name} home={href('/examples/home/')} links={links} />
  {!page.dashboard && <SourceMasthead page={page} />}
  {!page.dashboard && <nav class="nightjar-breadcrumb" aria-label="Breadcrumb"><a href={href('/examples/home/')}>Home</a> / <span aria-current="page">{page.title}</span></nav>}
  {!page.dashboard && <Content page={page} href={href} base={base} Button={Button} />}
  <slot />
  <SourceFooter slot="footer" name={name} groups={[{label:'Explore',links}]} />
</Layout>
