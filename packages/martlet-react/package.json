{
  "name": "@martlet/react",
  "version": "0.1.0",
  "description": "Martlet experimental React components, developed in a working component registry",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@martlet/theme": "2.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-styles.mjs martlet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howardjp/design-workbench.git",
    "directory": "packages/martlet-react"
  }
}
